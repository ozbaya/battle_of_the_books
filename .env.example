# Transcription + judging. Server only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Defaults shown; override only if needed.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Admin login (/admin).
ADMIN_PASSWORD=

# Redis (Vercel Marketplace / Upstash). Either naming is accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# "memory" uses the in-memory store (default when no Redis vars are set above).
STORE=memory

# "true" skips OpenAI entirely: /play shows a text box instead of recording,
# and judging uses fuzzy matching only. Useful for local testing without a
# mic or an API key.
MOCK_AI=true
